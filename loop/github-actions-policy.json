{
  "name": "loop: only workflows from the default branch run",
  "enforcement": "active",
  "conditions": { "workflow_path": { "include": ["~ALL"], "exclude": [] } },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": { "allowed_events": ["pull_request_target", "schedule"] }
    }
  ]
}
